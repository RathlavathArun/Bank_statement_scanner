# ─── Email / SMTP ───────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME="Bank Statement Scanner"

# ─── OTP Settings ───────────────────────────────────────────
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS_PER_HOUR=10

# ─── JWT ─────────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-secure-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Database ────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./bank_statements.db

# ─── App ─────────────────────────────────────────────────────
DEBUG=True
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── OCR Engine ──────────────────────────────────────────────
# "textract" = always use AWS Textract (errors if no creds)
# "tesseract" = always use local Tesseract (default for local dev)
# "auto" = try Textract first, fall back to Tesseract
OCR_ENGINE=auto
TEXTRACT_REGION=us-east-1
TEXTRACT_ASYNC_ENABLED=false    # set true for async S3-based jobs (large files)
TEXTRACT_FEATURE_TYPES=TABLES   # comma-separated: TABLES,FORMS

# ─── AWS Credentials (required when OCR_ENGINE=textract or auto) ─
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_DEFAULT_REGION=us-east-1
