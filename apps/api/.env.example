# ─── Email / SMTP ───────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME="Bank Statement Scanner"

# ─── OTP Settings ───────────────────────────────────────────
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS_PER_HOUR=10

# ─── JWT ─────────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-secure-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Database ────────────────────────────────────────────
# Run: docker-compose -f infra/docker-compose.yml up postgres -d
# SQLite is NOT supported — see docs/architecture/ADR-001-postgresql-migration.md
DATABASE_URL=postgresql+asyncpg://bse_admin:bse_secret_2026@localhost:5432/bank_statements

# ─── App ─────────────────────────────────────────────────────
DEBUG=True
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── OCR Engine ──────────────────────────────────────────────
# "textract" = always use AWS Textract (errors if no creds)
# "tesseract" = always use local Tesseract (default for local dev)
# "auto" = try Textract first, fall back to Tesseract
OCR_ENGINE=auto
TEXTRACT_REGION=ap-south-1
TEXTRACT_ASYNC_ENABLED=false    # set true for async S3-based jobs (large files)
TEXTRACT_FEATURE_TYPES=TABLES   # comma-separated: TABLES,FORMS

# Leave credentials empty on ECS so boto3 uses the task role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1

# ─── ClamAV (virus scanning) ─────────────────────────────
# Set to false to disable (e.g. for CI that can't run ClamAV daemon)
CLAMAV_ENABLED=true
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# ─── TOTP MFA ─────────────────────────────────────────
# Fernet key — generate once and store securely:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=your-32-byte-fernet-key-here

# ─── Anthropic / LLM ─────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-haiku-latest
LLM_BATCH_SIZE=20

# Zero Data Retention (Task 14 — PRD Phase 3)
# Step 1: Sign the ZDR agreement at https://console.anthropic.com/settings/privacy
# Step 2: Only THEN set this to true — it sends the `anthropic-beta: zero-data-retention-2024-02-23`
#         header on every API call so Anthropic does NOT log or retain any prompt/response data.
# WARNING: Setting this to true before signing the agreement will cause API errors.
ANTHROPIC_ZDR_ENABLED=false
