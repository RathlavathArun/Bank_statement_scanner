# ── Default: normalise all text files to LF in the index ──────
* text=auto eol=lf

# ── Shell scripts — must always be LF (run inside Docker/Linux)
*.sh    text eol=lf
*.bash  text eol=lf

# ── Python ────────────────────────────────────────────────────
*.py    text eol=lf
*.pyi   text eol=lf

# ── Web / TypeScript ──────────────────────────────────────────
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.css   text eol=lf
*.html  text eol=lf

# ── Config / Data ─────────────────────────────────────────────
*.yaml  text eol=lf
*.yml   text eol=lf
*.json  text eol=lf
*.toml  text eol=lf
*.ini   text eol=lf
*.cfg   text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.env   text eol=lf

# ── Terraform ─────────────────────────────────────────────────
*.tf     text eol=lf
*.tfvars text eol=lf
*.hcl    text eol=lf

# ── Docker ────────────────────────────────────────────────────
Dockerfile   text eol=lf
*.dockerfile text eol=lf

# ── Windows-native scripts — keep CRLF on Windows ────────────
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# ── Binary files — never touch line endings ───────────────────
*.pdf    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.zip    binary
*.gz     binary
*.tar    binary
*.xlsx   binary
*.xls    binary
*.db     binary
*.sqlite binary
*.pkg    binary
*.pyc    binary
